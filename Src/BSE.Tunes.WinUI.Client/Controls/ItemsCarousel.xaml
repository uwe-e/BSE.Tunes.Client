<UserControl
    x:Class="BSE.Tunes.WinUI.Client.Controls.ItemsCarousel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:behaviors="using:BSE.Tunes.WinUI.Client.Behaviors"
    xmlns:models="using:BSE.Tunes.WinUI.Client.Models"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Default Item Template -->
        <DataTemplate x:Key="DefaultItemTemplate" x:DataType="models:CarouselItem">
            <!--<ItemContainer IsSelected="False"
                           ManipulationMode="System">-->
            <Grid CornerRadius="8" 
Width="{Binding ItemWidth, ElementName=RootControl}"
                Height="{Binding ItemHeight, ElementName=RootControl}"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                <!-- Item Image -->
                <Image Source="{x:Bind ImageSource, Mode=OneWay}"
                       Stretch="UniformToFill"/>

                <!-- Overlay with text -->
                <Grid VerticalAlignment="Bottom"
                      Background="#CC000000"
                      Padding="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis"
                                   TextAlignment="Center"/>
                        <TextBlock Text="{x:Bind SubTitle, Mode=OneWay}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="#CCFFFFFF"
                                   TextTrimming="CharacterEllipsis"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Interaction Button -->
                <!--<Button Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        CornerRadius="8"
                        Command="{Binding ItemClickCommand, ElementName=RootControl}"
                        CommandParameter="{x:Bind}"/>-->
            </Grid>
            <!--</ItemContainer>-->
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="RootControl">

        <ScrollViewer HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Disabled"
              HorizontalScrollMode="Enabled"
              VerticalScrollMode="Disabled"
              behaviors:ScrollViewerDragBehavior.IsEnabled="True">

            <ItemsRepeater x:Name="ItemsRepeaterControl"
                  ItemsSource="{x:Bind ItemsSource, Mode=OneWay}"
                  ItemTemplate="{x:Bind EffectiveItemTemplate, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" 
                        Spacing="{x:Bind ItemSpacing, Mode=OneWay}"/>
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>
        <!--<ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Enabled"
                      VerticalScrollMode="Disabled">-->

        <!--<ListView x:Name="ItemsRepeaterControl"
              ItemsSource="{x:Bind ItemsSource, Mode=OneWay}"
              ItemTemplate="{x:Bind EffectiveItemTemplate, Mode=OneWay}"
              SelectionMode="None"
              IsItemClickEnabled="True"
              ItemClick="OnItemClick"
              ScrollViewer.HorizontalScrollBarVisibility="Auto"
              ScrollViewer.VerticalScrollBarVisibility="Disabled"
              ScrollViewer.HorizontalScrollMode="Enabled"
              ScrollViewer.VerticalScrollMode="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" 
                           Spacing="{Binding ItemSpacing, ElementName=RootControl}"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>-->

        <!--<ItemsView x:Name="ItemsRepeaterControl"
                       ItemsSource="{x:Bind ItemsSource, Mode=OneWay}"
                       ItemTemplate="{x:Bind EffectiveItemTemplate, Mode=OneWay}"
                       SelectionMode="None"
                       ItemInvoked="OnItemInvoked"
                       Loaded="OnItemsViewLoaded">
                <ItemsView.Layout>
                    <StackLayout Orientation="Horizontal" 
                                 Spacing="{x:Bind ItemSpacing, Mode=OneWay}"/>
                </ItemsView.Layout>
            </ItemsView>-->
            <!--IsTapEnabled="True" Tapped="OnItemsRepeaterElementTapped"
                           ElementPrepared="OnItemsRepeaterElementPrepared" -->
            <!--<ItemsRepeater x:Name="ItemsRepeaterControl"
                          ItemsSource="{x:Bind ItemsSource, Mode=OneWay}"
                          ItemTemplate="{x:Bind EffectiveItemTemplate, Mode=OneWay}"
                          >
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" 
                                Spacing="{x:Bind ItemSpacing, Mode=OneWay}"/>
                </ItemsRepeater.Layout>
            </ItemsRepeater>-->
        <!--</ScrollViewer>-->

        <!-- Loading Indicator -->
        <Grid Visibility="{x:Bind ShowLoadingIndicator, Mode=OneWay}"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <ProgressRing IsActive="{x:Bind IsBusy, Mode=OneWay}"
                         Width="40"
                         Height="40"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>