
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BSE.Tunes.WinUI.Client.Models"
    xmlns:controls="using:BSE.Tunes.WinUI.Client.Controls">

    <Style x:Key="HeaderedSectionHeader" TargetType="HyperlinkButton">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Foreground" Value="{ThemeResource SystemChromeWhiteColor}"/>
    </Style>

    <!-- Override the system style -->
    <Style x:Key="AppTitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontSize" Value="30"/>
        <!-- Add your custom property overrides -->
    </Style>

    <DataTemplate x:Key="SmallImagePanelTemplate">
        <Grid Width="150">
            <Grid.RowDefinitions>
                <RowDefinition Height="150"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Image Source="{Binding ImageSource}"
               Stretch="UniformToFill" Height="150" Grid.Row="0"/>
            <TextBlock Grid.Row="1" Text="{Binding Title}" TextTrimming="WordEllipsis" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="2" Text="{Binding SubTitle}" FontWeight="SemiLight" TextTrimming="WordEllipsis" FontSize="12"/>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="FlyoutItemTemplate">
        <Grid>
            <controls:MenuFlyoutItem IsIconEnabled="True"
                                 Text="{Binding Text}"
                                 Visibility="{Binding IsSeparator, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=true}">
                <controls:MenuFlyoutItem.Icon>
                    <FontIcon Glyph="{Binding Glyph}"/>
                </controls:MenuFlyoutItem.Icon>
            </controls:MenuFlyoutItem>
            <MenuFlyoutSeparator Visibility="{Binding IsSeparator, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=false}"/>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
