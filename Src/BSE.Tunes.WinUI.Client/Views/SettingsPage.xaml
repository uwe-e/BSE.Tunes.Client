<Page
    x:Class="BSE.Tunes.WinUI.Client.Views.SettingsPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:BSE.Tunes.WinUI.Client.Models"
    xmlns:behaviors="using:BSE.Tunes.WinUI.Client.Behaviors"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Spacing="4" Padding="0,0,0,24">
            <!-- Page Header -->
            <!--<TextBlock 
                Text="Settings" 
                Style="{ThemeResource TitleLargeTextBlockStyle}"
                Margin="0,0,0,4"/>-->

            <!-- App Version -->
            <!--<TextBlock 
                Text="{x:Bind ViewModel.VersionDescription, Mode=OneWay}" 
                Style="{ThemeResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Margin="0,0,0,24"/>-->

            <!-- Settings List -->
            <ListView
                ItemsSource="{x:Bind ViewModel.SettingsItems, Mode=OneWay}"
                SelectionMode="None"
                IsItemClickEnabled="True">
                <i:Interaction.Behaviors>
                    <behaviors:ListViewItemClickBehavior Command="{x:Bind ViewModel.NavigateToSettingCommand}"/>
                </i:Interaction.Behaviors>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="MinHeight" Value="68"/>
                        <Setter Property="Margin" Value="0,0,0,2"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:SettingsItem">
                        <Grid 
                            Padding="0,12,16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icon -->
                            <Grid 
                                Grid.Column="0"
                                Width="40"
                                Height="40"
                                CornerRadius="4"
                                Background="Transparent">
                                <FontIcon 
                                    Glyph="{x:Bind Glyph}"
                                    FontSize="20"/>
                            </Grid>

                            <!-- Title and Description -->
                            <StackPanel 
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock 
                                    Text="{x:Bind Title}"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                <TextBlock 
                                    Text="{x:Bind Description}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Chevron -->
                            <FontIcon 
                                Grid.Column="2"
                                Glyph="&#xE76C;"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
