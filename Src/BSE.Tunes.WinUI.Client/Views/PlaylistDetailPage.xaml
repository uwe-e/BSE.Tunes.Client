<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BSE.Tunes.WinUI.Client.Views.PlaylistDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BSE.Tunes.WinUI.Client.Views"
    xmlns:models="using:BSE.Tunes.WinUI.Client.Models"
    xmlns:controls="using:BSE.Tunes.WinUI.Client.Controls"
    xmlns:behaviors="using:BSE.Tunes.WinUI.Client.Behaviors"
    xmlns:extensions="using:BSE.Tunes.WinUI.Client.Extensions"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    behaviors:NavigationViewHeaderBehavior.HeaderMode="Never"
    x:Name="page"
    mc:Ignorable="d">

    <Page.Resources>

        <DataTemplate x:Key="PlaylistFlyoutItemTemplate" x:DataType="models:FlyoutItem">
            <Grid>
                <controls:MenuFlyoutItem IsIconEnabled="True"
                                      Text="{Binding Text}"
                                      Visibility="{Binding IsSeparator, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=true}">
                    <controls:MenuFlyoutItem.Icon>
                        <FontIcon Glyph="{Binding Glyph}"/>
                    </controls:MenuFlyoutItem.Icon>
                </controls:MenuFlyoutItem>
                <MenuFlyoutSeparator Visibility="{Binding IsSeparator, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=false}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="EntryItemTemplate" x:DataType="models:PlaylistEntryItem">
            <UserControl>
                <Grid x:Name="listViewItem" Height="44">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Grid.ContextFlyout>
                        <controls:ConditionalMenuFlyout IsVisible="{Binding ViewModel.IsCommandBarVisible, Converter={StaticResource BoolNegationConverter}, ElementName=page, Mode=OneWay}">
                            <MenuFlyoutItem x:Uid="PlaylistDetailPage_MenuFlyoutItem_Play"
                                            Text="Play"
                                            Command="{Binding ViewModel.PlayTrackCommand, ElementName=page}"
                                            CommandParameter="{Binding}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE768;" FontSize="16"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="PlaylistDetailPage_MenuFlyoutItem_PlayAsNext"
                                            Text="Play Next"
                                            Command="{Binding ViewModel.SelectAndPlayAsNextCommand, ElementName=page}"
                                            CommandParameter="{Binding}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE90B;" FontSize="16"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="PlaylistDetailPage_MenuFlyoutItem_ShowAlbum"
                                            Text="Show Album"
                                            Command="{Binding ViewModel.ShowAlbumCommand, ElementName=page}"
                                            CommandParameter="{Binding}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE93C;" FontSize="16"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="PlaylistDetailPage_MenuFlyoutItem_SelectItem"
                                            Text="Select"
                                            Command="{Binding ViewModel.SelectItemsCommand, ElementName=page}"
                                            CommandParameter="{Binding}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE73E;" FontSize="16"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </controls:ConditionalMenuFlyout>
                    </Grid.ContextFlyout>
                    <TextBlock Grid.Column="0" 
                               Text="{x:Bind Name, Mode=OneWay}"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1" 
                               Text="{x:Bind Artist, Mode=OneWay}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="12,0,0,0"/>

                    <TextBlock Grid.Column="2" 
                               Text="{x:Bind Album, Mode=OneWay}"
                               Visibility="{Binding ViewModel.IsCommandBarVisible, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=False, ElementName=page, Mode=OneWay}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="12,0,0,0"/>

                    <HyperlinkButton Grid.Column="2" 
                            VerticalAlignment="Center"
                            Visibility="{Binding ViewModel.IsCommandBarVisible, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=True, ElementName=page, Mode=OneWay}"
                            Margin="12,0,0,0" Foreground="{ThemeResource DefaultTextForegroundThemeBrush}">
                        <HyperlinkButton.Content>
                            <TextBlock Text="{x:Bind Album, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                        </HyperlinkButton.Content>
                    </HyperlinkButton>

                    <TextBlock Grid.Column="3" 
                               Text="{x:Bind Year, Mode=OneWay}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="12,0,0,0"/>

                    <TextBlock Grid.Column="4" 
                               Text="{x:Bind Genre, Mode=OneWay}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="12,0,0,0"/>

                    <TextBlock Grid.Column="5" 
                               Text="{x:Bind FormattedDuration, Mode=OneWay}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="12,0,0,0"/>
                </Grid>
            </UserControl>
        </DataTemplate>

    </Page.Resources>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Sticky header wrapped in UserControl to enable VisualStateManager support.
                VisualStates are defined on the inner Grid and controlled by StickyHeaderBehavior.
                When scrolling down, 'Collapsed' state hides subtitle/genre and shows action buttons
                When scrolling up, 'Expanded' state shows subtitle/genre and hides action buttons. -->
            <UserControl x:Name="infoHeader"
             Grid.Row="0">

                <Grid Padding="5" Background="{ThemeResource CardBackgroundSolidColorDefault}"
                      CornerRadius="4">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="ScrollStates">
                            <VisualState x:Name="Expanded">
                                <VisualState.Setters>
                                    <!--<Setter Target="infoSubTitle.Visibility" Value="Visible"/>
                                    <Setter Target="infoSubTitle.Opacity" Value="1"/>-->
                                    <Setter Target="additionalInfo.Visibility" Value="Visible"/>
                                    <Setter Target="additionalInfo.Opacity" Value="1"/>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Collapsed">
                                <VisualState.Setters>
                                    <!--<Setter Target="infoSubTitle.Visibility" Value="Collapsed"/>
                                    <Setter Target="infoSubTitle.Opacity" Value="0"/>-->
                                    <Setter Target="additionalInfo.Visibility" Value="Collapsed"/>
                                    <Setter Target="additionalInfo.Opacity" Value="0"/>
                                    <!--<Setter Target="infoAction.VerticalAlignment" Value="Top"/>-->
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Image x:Name="infoCover"
                           Grid.Column="0"
                           Source="{x:Bind ViewModel.ImageSource, Mode=OneWay}"
                           Width="240"
                           Height="240"
                           Margin="10"
                           Stretch="UniformToFill"/>

                    <Grid x:Name="infoProperties" 
                          Grid.Column="1"
                          Margin="10" 
                          VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <!--<RowDefinition Height="Auto"/>-->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="infoTitle" 
                                   Grid.Row="0"
                                   Text="{x:Bind ViewModel.Playlist.Name, Mode=OneWay}"
                                   Style="{StaticResource TitleLargeTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"/>

                        <!--<TextBlock x:Name="infoSubTitle"
                                   Grid.Row="1"
                                   Margin="0,8,0,8"
                                   Text="{x:Bind ViewModel.Album.Artist.Name, Mode=OneWay}"
                                   Style="{StaticResource BodyLargeTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis"/>-->

                        <TextBlock x:Name="additionalInfo" 
                                   Grid.Row="1"
                                   Margin="0,8,0,8"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="{x:Bind ViewModel.Playlist.NumberEntries, Mode=OneWay}"/>
                            <Run Text=" "/>
                            <Run x:Uid="PlaylistDetailPage_NumberEntries" Text="Elements"/>
                        </TextBlock>

                        <StackPanel x:Name="infoAction" 
                                    Grid.Row="2"
                                    Margin="0,4,0,0"
                                    Orientation="Horizontal">

                            <Button Margin="0,0,4,0"
                                    Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.PlayAllCommand}"
                                    Visibility="{x:Bind ViewModel.IsCommandBarVisible, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=True, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE768;" FontSize="16"/>
                                    <TextBlock x:Uid="AlbumDetailPage_ButtonPlayAll" Text="Play All"/>
                                </StackPanel>
                            </Button>

                            <Button Margin="0,0,4,0" Command="{x:Bind ViewModel.PlayAllShuffleCommand}"
                                    Visibility="{x:Bind ViewModel.IsCommandBarVisible, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=True, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B1;" FontSize="16"/>
                                    <TextBlock x:Uid="AlbumDetailPage_ButtonShuffle" Text="Shuffle"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="buttonAddAllTo"
                                    Margin="4,0,8,0"
                                    IsEnabled="{x:Bind ViewModel.IsCommandBarVisible, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;"/>
                                    <TextBlock x:Uid="AlbumDetailPage_ButtonAddAllTo" Text="Add To"/>
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout extensions:FlyoutExtensions.Parent="{x:Bind buttonAddAllTo}"
                                            extensions:FlyoutExtensions.ItemsSource="{x:Bind ViewModel.PlaylistMenuItemsForAll}"
                                            extensions:FlyoutExtensions.ItemTemplate="{StaticResource PlaylistFlyoutItemTemplate}"
                                            extensions:FlyoutExtensions.ItemCommand="{x:Bind ViewModel.MenuItemClickedCommand}" />
                                </Button.Flyout>
                            </Button>

                            <Button Command="{x:Bind ViewModel.RemovePlaylistCommand}"
                                    Visibility="{x:Bind ViewModel.IsCommandBarVisible, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=True, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="16"/>
                                    <TextBlock x:Uid="AlbumDetailPage_ButtonRemovePlaylist" Text="Remove Playlist"/>
                                </StackPanel>
                            </Button>
                            
                        </StackPanel>
                    </Grid>

                </Grid>
            </UserControl>
<!-- Padding="0,54,0,0"
            
            
            
            -->
            <controls:ExtendedListView x:Name="listview"
                                       Grid.Row="1"
                                       Margin="0,5"
                                       AllowDrop="{x:Bind ViewModel.HasSelectedItems, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                                       CanDragItems="True" CanReorderItems="True"
                                       ItemTemplate="{StaticResource EntryItemTemplate}"
                                       ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                                       EnablePreSelection="True"
                                       SelectionMode="{x:Bind ViewModel.SelectionMode, Mode=OneWay}"
                                       AlternatingRow="{ThemeResource SubtleFillColorSecondaryBrush}"
                                       SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                                       controls:ListViewExtensions.Command="{x:Bind ViewModel.PlayTrackCommand}"
                                       controls:ListViewExtensions.SelectedItems="{x:Bind ViewModel.SelectedItems, Mode=TwoWay}"
                                       IsItemClickEnabled="{x:Bind ViewModel.IsItemClickEnabled}"
                                       PreSelectionCommand="{x:Bind ViewModel.SelectItemsCommand}">
                <controls:ExtendedListView.Header>
                    <Border Height="54"/>
                </controls:ExtendedListView.Header>
                <interactivity:Interaction.Behaviors>
                    <behaviors:StickyHeaderBehavior 
                        HeaderElement="{x:Bind infoHeader}"
                        CoverImage="{x:Bind infoCover}"
                        MaxHeaderHeight="240"
                        MinHeaderHeight="120"
                        MaxCoverSize="220"
                        MinCoverSize="100"
                        ScrollThreshold="160"/>
                    <interactivity:EventTriggerBehavior EventName="DragItemsStarting">
                        <interactivity:InvokeCommandAction Command="{x:Bind ViewModel.DragItemsStartingCommand}"/>
                    </interactivity:EventTriggerBehavior>
                    <interactivity:EventTriggerBehavior EventName="DragItemsCompleted">
                        <interactivity:InvokeCommandAction Command="{x:Bind ViewModel.DragItemsCompletedCommand}"/>
                    </interactivity:EventTriggerBehavior>
                </interactivity:Interaction.Behaviors>
            </controls:ExtendedListView>

            <Border Grid.Row="1"
                    Margin="0,5"
                    VerticalAlignment="Top"
                    Canvas.ZIndex="10"
                    Visibility="{x:Bind ViewModel.IsCommandBarVisible, Mode=OneWay}">
                <CommandBar x:Name="stickyCommandBar"
                            CornerRadius="4"
                            DefaultLabelPosition="Right"
                            Background="{ThemeResource CardBackgroundSolidColorDefault}">
                    <CommandBar.Shadow>
                        <ThemeShadow/>
                    </CommandBar.Shadow>
                    <AppBarButton x:Uid="AlbumDetailPage_ButtonClearSelection" Label="Clear Selection"
                                  Command="{x:Bind ViewModel.ClearSelectionCommand}">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEA98;"/>
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton x:Uid="AlbumDetailPage_ButtonPlay" Icon="Play" Label="Play Selection"
                      Command="{x:Bind ViewModel.PlaySelectedCommand}">
                        <AppBarButton.Resources>
                            <StaticResource x:Key="AppBarButtonBackground" ResourceKey="AccentButtonBackground"/>
                            <StaticResource x:Key="AppBarButtonForeground" ResourceKey="AccentButtonForeground"/>
                            <StaticResource x:Key="AppBarButtonBackgroundPointerOver" ResourceKey="AccentButtonBackgroundPointerOver"/>
                            <StaticResource x:Key="AppBarButtonForegroundPointerOver" ResourceKey="AccentButtonForegroundPointerOver"/>
                            <StaticResource x:Key="AppBarButtonBackgroundPressed" ResourceKey="AccentButtonBackgroundPressed"/>
                            <StaticResource x:Key="AppBarButtonForegroundPressed" ResourceKey="AccentButtonForegroundPressed"/>
                        </AppBarButton.Resources>
                    </AppBarButton>
                    <AppBarButton x:Uid="AlbumDetailPage_ButtonPlaySelection" Icon="MusicInfo" Label="Play Next"
                      Command="{x:Bind ViewModel.PlayAsNextCommand}"/>
                    <AppBarButton x:Uid="AlbumDetailPage_ButtonAddTo" x:Name="buttonAddTo" Icon="Add" Label="Add to Playlist">
                        <AppBarButton.Flyout>
                            <Flyout extensions:FlyoutExtensions.Parent="{x:Bind buttonAddTo}"
                                    extensions:FlyoutExtensions.ItemsSource="{x:Bind ViewModel.PlaylistMenuItemsForSelected}"
                                    extensions:FlyoutExtensions.ItemTemplate="{StaticResource PlaylistFlyoutItemTemplate}"
                                    extensions:FlyoutExtensions.ItemCommand="{x:Bind ViewModel.MenuItemClickedCommand}"/>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                    <AppBarButton x:Uid="AlbumDetailPage_ButtonRemoveSelection" Label="Remove"
                                  Command="{x:Bind ViewModel.RemoveSelectionCommand}">
                        <AppBarButton.Icon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE894;"/>
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton x:Uid="AlbumDetailPage_ButtonSelectAll" Icon="SelectAll" Label="Add to Playlist"
                                  Command="{x:Bind ViewModel.SelectAllCommand}"
                                  Visibility="{x:Bind ViewModel.AllItemsSelected, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=True, Mode=OneWay}"/>
                    <AppBarButton x:Uid="AlbumDetailPage_ButtonUnSelectAll" Icon="ClearSelection" Label="Add to Playlist"
                                  Command="{x:Bind ViewModel.UnSelectAllCommand}"
                                  Visibility="{x:Bind ViewModel.AllItemsSelected, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}"/>
                </CommandBar>
            </Border>
        </Grid>
        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                      Width="40"
                      Height="40"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
    </Grid>
</Page>
