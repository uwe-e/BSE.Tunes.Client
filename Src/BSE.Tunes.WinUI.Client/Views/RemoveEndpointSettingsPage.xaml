<Page
    x:Class="BSE.Tunes.WinUI.Client.Views.RemoveEndpointSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Spacing="24" Padding="0,0,0,24">
            <!-- Header -->
            <TextBlock x:Uid="RemoveEndpointSettingsPage_Title"
                Style="{ThemeResource TitleLargeTextBlockStyle}"/>

            <!-- Current Endpoint Card -->
            <Grid
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8"
                Padding="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="4">
                    <TextBlock x:Uid="RemoveEndpointSettingsPage_Description"
                        Text="Current Service Endpoint"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    <TextBlock 
                        Text="{x:Bind ViewModel.ServiceEndPoint, Mode=OneWay}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="8" Margin="0,16,0,0">
                    <TextBlock x:Uid="RemoveEndpointSettingsPage_Warning"
                        Text="Removing the service endpoint will require you to configure it again."
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"/>

                    <Button x:Uid="RemoveEndpointSettingsPage_DeleteButton"
                        Content="Delete Endpoint"
                        Command="{x:Bind ViewModel.DeleteSettingsCommand}"
                        Style="{ThemeResource AccentButtonStyle}"
                        HorizontalAlignment="Left"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>