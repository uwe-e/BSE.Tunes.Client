<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BSE.Tunes.WinUI.Client.Views.CacheSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Spacing="24" Padding="0,0,0,24">
            <!-- Header -->
            <TextBlock x:Uid="CacheSettingsPage_Title"
                       Text="Storage &amp; Cache"
                       Style="{ThemeResource TitleLargeTextBlockStyle}"/>

            <!-- Cache Information Card -->
            <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  CornerRadius="8"
                  Padding="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Image Cache -->
                <StackPanel Grid.Row="0" Spacing="4">
                    <TextBlock x:Uid="CacheSettingsPage_ImageCache_Title"
                               Text="Image Cache"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.ImageCacheSize, Mode=OneWay}"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Audio Cache -->
                <StackPanel Grid.Row="1" Spacing="4" Margin="0,16,0,0">
                    <TextBlock x:Uid="CacheSettingsPage_AudioCache_Title"
                               Text="Audio Cache"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.AudioCacheSize, Mode=OneWay}"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Delete Button -->
                <StackPanel Grid.Row="2" Spacing="8" Margin="0,24,0,0">
                    <TextBlock x:Uid="CacheSettingsPage_Warning"
                               Text="Clearing cache will remove all downloaded images and audio files. You will need to download them again when you play content."
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>

                    <Button x:Uid="CacheSettingsPage_DeleteButton"
                            Command="{x:Bind ViewModel.DeleteSettingsCommand}"
                            Style="{ThemeResource AccentButtonStyle}"
                            HorizontalAlignment="Left"
                            IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing Width="16"
                                              Height="16"
                                              IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}"/>
                                <TextBlock x:Uid="CacheSettingsPage_DeleteButton_Text"
                                           Text="Clear Cache"
                                           Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=True}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Information Section -->
            <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  CornerRadius="8"
                  Padding="16">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE946;"
                                  FontSize="16"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                        <TextBlock x:Uid="CacheSettingsPage_Info_Title"
                                   Text="About Cache"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    </StackPanel>
                    
                    <TextBlock x:Uid="CacheSettingsPage_Info_Description"
                               Text="Cache stores downloaded content for offline playback and faster loading. The app automatically manages cache size, but you can manually clear it if needed."
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
