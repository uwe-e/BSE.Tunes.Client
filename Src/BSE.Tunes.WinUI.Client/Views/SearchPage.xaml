<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BSE.Tunes.WinUI.Client.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BSE.Tunes.WinUI.Client.Views"
    xmlns:models="using:BSE.Tunes.WinUI.Client.Models"
    xmlns:controls="using:BSE.Tunes.WinUI.Client.Controls"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:extensions="using:BSE.Tunes.WinUI.Client.Extensions"
    xmlns:behaviors="using:BSE.Tunes.WinUI.Client.Behaviors"
    x:Name="page"
    behaviors:NavigationViewHeaderBehavior.HeaderMode="Never"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="MenuFlyoutItemTemplate" x:DataType="models:FlyoutItem">
            <!--<Grid>-->
                <!--<controls:MenuFlyoutItem IsIconEnabled="True"
                                 Text="{Binding Text}"
                                 Visibility="{Binding IsSeparator, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=true}">
                    <controls:MenuFlyoutItem.Icon>
                        <FontIcon Glyph="{Binding Glyph}"/>
                    </controls:MenuFlyoutItem.Icon>
                </controls:MenuFlyoutItem>-->
            <MenuFlyoutItem 
                 Text="{Binding Text}"
                 Visibility="{Binding IsSeparator, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=true}">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="{Binding Glyph}"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <!--<MenuFlyoutSeparator Visibility="{Binding IsSeparator, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=false}"/>-->
            <!--</Grid>-->
        </DataTemplate>
    </Page.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{x:Bind ViewModel.TitleText}" Style="{ThemeResource TitleTextBlockStyle}"
            FontWeight="SemiBold"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
            <StackPanel Spacing="20" Padding="0,20,0,20">
                <Grid Visibility="{x:Bind ViewModel.HasAlbums, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Uid="SearchPage_Albums_Header" Text="Albums" FontSize="20" FontWeight="SemiBold"/>

                    <ListView Grid.Row="1"
                              Margin="0,12,0,0"
                              ItemsSource="{x:Bind ViewModel.Albums, Mode=OneWay}"
                              IsItemClickEnabled="True"
                              SelectionMode="Single"
                              IncrementalLoadingTrigger="None"
                              HorizontalAlignment="Stretch"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              controls:ListViewExtensions.Command="{x:Bind ViewModel.SelectAlbumCommand}">
                        <interactivity:Interaction.Behaviors>
                            <behaviors:CompleteRowIncrementalLoadingBehavior
                                Command="{x:Bind ViewModel.EnsureVisibleAlbumCapacityCommand}"
                                ItemWidth="150"
                                ItemRightMargin="15" />
                        </interactivity:Interaction.Behaviors>

                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Margin" Value="0,5,0,5" />
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CarouselItem">
                                <Grid Width="150">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="150" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Image Source="{x:Bind ImageSource, Mode=OneWay}"
                                           Stretch="UniformToFill"
                                           Height="150"
                                           Grid.Row="0" />
                                    <TextBlock Grid.Row="1"
                                               Text="{x:Bind Title, Mode=OneWay}"
                                               TextTrimming="WordEllipsis"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="2"
                                               Text="{x:Bind SubTitle, Mode=OneWay}"
                                               FontWeight="SemiLight"
                                               TextTrimming="WordEllipsis"
                                               FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid Visibility="{x:Bind ViewModel.HasTracks, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Uid="SearchPage_Tracks_Header" Text="Songs" FontSize="20" FontWeight="SemiBold"/>

                    <controls:ExtendedListView Grid.Row="1"
                                               Margin="0,12,0,0"
                                               ItemsSource="{x:Bind ViewModel.Tracks, Mode=OneWay}"
                                               IsItemClickEnabled="True"
                                               AlternatingRow="{ThemeResource SubtleFillColorSecondaryBrush}"
                                               SelectionMode="None"
                                               controls:ListViewExtensions.Command="{x:Bind ViewModel.PlayTrackCommand}">
                        <controls:ExtendedListView.ItemTemplate>
                            <DataTemplate x:DataType="models:TrackItem">
                                <Grid Height="44">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="300"/>
                                        <ColumnDefinition Width="300"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind Title, Mode=OneWay}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="12,0,0,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind Artist, Mode=OneWay}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="12,0,0,0"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind Album, Mode=OneWay}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="12,0,0,0"/>
                                    <TextBlock Grid.Column="4"
                                               Text="{x:Bind FormattedDuration, Mode=OneWay}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Play">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE768;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Add to Queue">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE90B;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSubItem Text="Add to Playlist"
                                                               extensions:MenuFlyoutSubItemExtensions.ItemsSource="{Binding ViewModel.PlaylistMenuItems, ElementName=page, Mode=OneWay}"
                                                               extensions:MenuFlyoutSubItemExtensions.ItemTemplate="{StaticResource MenuFlyoutItemTemplate}"
                                                               extensions:MenuFlyoutSubItemExtensions.ItemCommand="{Binding ViewModel.AddToPlaylistCommand, ElementName=page, Mode=OneWay}">
                                                <MenuFlyoutSubItem.Icon>
                                                    <FontIcon Glyph="&#xE710;"/>
                                                </MenuFlyoutSubItem.Icon>
                                            </MenuFlyoutSubItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                </Grid>
                            </DataTemplate>
                        </controls:ExtendedListView.ItemTemplate>
                    </controls:ExtendedListView>
                </Grid>

                <TextBlock x:Uid="SearchPage_NoResults_Text"
                           Text="No results found."
                           Visibility="{x:Bind ViewModel.HasNoResults, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}"/>
            </StackPanel>
        </ScrollViewer>

        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                      Width="40"
                      Height="40"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
    </Grid>
</Page>
