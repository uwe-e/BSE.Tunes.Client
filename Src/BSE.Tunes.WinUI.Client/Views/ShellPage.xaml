<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BSE.Tunes.WinUI.Client.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BSE.Tunes.WinUI.Client.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <NavigationView x:Name="NavigationViewControl"
                        IsBackButtonVisible="Visible"
                        IsSettingsVisible="True">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home" />
                <NavigationViewItem Content="Library" Tag="library" />
                <NavigationViewItem>
                    <StackPanel Orientation="Horizontal">
                        <ImageIcon Source="ms-appx:///Assets/playlist.svg" Height="20" Width="24" />
                        <TextBlock x:Uid="Shell_TxtPlaylists" Margin="5,0,0,0"
                                   VerticalAlignment="Stretch"
                                   Text="Playlists" />
                    </StackPanel>
                </NavigationViewItem>
                <NavigationViewItem Content="Artists" Tag="artists" />
                <NavigationViewItem Content="Albums" Tag="albums" />
            </NavigationView.MenuItems>
        </NavigationView>
        
        
    </Grid>
</Page>
