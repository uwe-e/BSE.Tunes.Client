<Page
    x:Class="BSE.Tunes.WinUI.Client.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:BSE.Tunes.WinUI.Client.Helpers"
    xmlns:behaviors="using:BSE.Tunes.WinUI.Client.Behaviors"
    xmlns:services="using:BSE.Tunes.WinUI.Client.Services"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:views="using:BSE.Tunes.WinUI.Client.Controls"
    MinWidth="640"
    Loaded="OnLoaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <MediaPlayerElement x:Name="AudioMediaElement"
                            AreTransportControlsEnabled="False"
                            services:MediaService.RegisterAsMediaService="True"/>
        <TitleBar x:Name="AppTitleBar"
                  Canvas.ZIndex="1"
                  Height="{Binding ElementName=NavigationViewControl, Path=CompactPaneLength}"
                  IsPaneToggleButtonVisible="True"
                  IsBackButtonVisible="{x:Bind ViewModel.IsBackEnabled, Mode=OneWay}"
                  IsHitTestVisible="True"
                  VerticalAlignment="Top">
            <TitleBar.Resources>
                <!--
                TitleBar.Content uses Center alignment by default, which
                sizes content to its DesiredSize. Override to Stretch so
                the search box fills the available area up to MaxWidth.
                -->
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <i:Interaction.Behaviors>
                <i:EventTriggerBehavior EventName="PaneToggleRequested">
                    <i:InvokeCommandAction Command="{x:Bind ViewModel.TogglePaneCommand}" CommandParameter="{Binding ElementName=NavigationViewControl, Path=IsPaneOpen}"/>
                </i:EventTriggerBehavior>
                <i:EventTriggerBehavior EventName="BackRequested">
                    <i:InvokeCommandAction Command="{x:Bind ViewModel.GoBackCommand}"/>
                </i:EventTriggerBehavior>
            </i:Interaction.Behaviors>
            <TitleBar.Content>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                        <Image Source="/Assets/logo.svg"
                               Grid.Column="0"
                           HorizontalAlignment="Left"
                           Width="48"
                           Height="48" />
                    <TextBlock x:Name="AppTitleBarText"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"
                               Style="{StaticResource AppTitleTextBlockStyle}"
                               Margin="10,0,0,0"/>
                    <AutoSuggestBox x:Name="controlsSearchBox"
                                    Grid.Column="2"
                                    MaxWidth="580"
                                    HorizontalAlignment="Stretch"
                                    Margin="30,0,0,0"
                                    VerticalAlignment="Center"
                                    x:FieldModifier="public"
                                    KeyboardAcceleratorPlacementMode="Hidden"
                                    PlaceholderText="Search controls and samples..."
                                    QueryIcon="Find">
                        <AutoSuggestBox.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F" Modifiers="Control" />
                        </AutoSuggestBox.KeyboardAccelerators>
                    </AutoSuggestBox>
                </Grid>
                
            </TitleBar.Content>
            
        </TitleBar>
        <NavigationView
            x:Name="NavigationViewControl"
            Canvas.ZIndex="0"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            SelectedItem="{x:Bind ViewModel.Selected, Mode=OneWay}"
            IsSettingsVisible="True"
            IsPaneOpen="{x:Bind ViewModel.IsPaneOpen, Mode=TwoWay}"
            Header="{x:Bind ((ContentControl)ViewModel.Selected).Content, Mode=OneWay}">
            <NavigationView.MenuItems>
                <!--
                TODO: Update item titles by updating <x:Uid>.Content entries in Strings/en-us/Resources.resw.
                https://docs.microsoft.com/windows/uwp/app-resources/localize-strings-ui-manifest#refer-to-a-string-resource-identifier-from-xaml
            
                TODO: Update item icons by updating FontIcon.Glyph properties.
                https://docs.microsoft.com/windows/apps/design/style/segoe-fluent-icons-font#icon-list
                -->
                <NavigationViewItem x:Uid="ShellPage_Main" helpers:NavigationHelper.NavigateTo="MainPage">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEA8A;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="ShellPage_AlbumsPage" helpers:NavigationHelper.NavigateTo="AlbumsPage">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8D6;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="ShellPage_PlaylistssPage" helpers:NavigationHelper.NavigateTo="PlaylistsPage">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8FD;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.HeaderTemplate>
                <DataTemplate>
                    <Grid>
                        <TextBlock
                            Text="{Binding}"
                            Style="{ThemeResource TitleTextBlockStyle}" />
                    </Grid>
                </DataTemplate>
            </NavigationView.HeaderTemplate>
            <i:Interaction.Behaviors>
                <behaviors:NavigationViewHeaderBehavior
                    DefaultHeader="{x:Bind ((ContentControl)ViewModel.Selected).Content, Mode=OneWay}">
                    <behaviors:NavigationViewHeaderBehavior.DefaultHeaderTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock
                                    Text="{Binding}"
                                    Style="{ThemeResource TitleTextBlockStyle}" />
                            </Grid>
                        </DataTemplate>
                    </behaviors:NavigationViewHeaderBehavior.DefaultHeaderTemplate>
                </behaviors:NavigationViewHeaderBehavior>
            </i:Interaction.Behaviors>
            <Grid Margin="{StaticResource NavigationViewPageContentMargin}">
                <Frame x:Name="NavigationFrame" />
            </Grid>
        </NavigationView>
        <views:PlayerBarView Grid.Row="2"/>
    </Grid>
</Page>
