<Application
    x:Class="BSE.Tunes.WinUI.Client.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:BSE.Tunes.WinUI.Client.Helpers"
    xmlns:converters="using:BSE.Tunes.WinUI.Client.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="/Styles/FontSizes.xaml" />
                <ResourceDictionary Source="/Styles/Thickness.xaml" />
                <ResourceDictionary Source="/Styles/TextBlock.xaml" />

                <ResourceDictionary Source="/Controls/Carousel/Carousel.xaml" />
                <ResourceDictionary Source="/Controls/ListView/ExtendedListViewItem.xaml" />


            </ResourceDictionary.MergedDictionaries>

            <!-- Value Converters -->
            <helpers:BoolNegationConverter x:Key="BoolNegationConverter"/>
            <helpers:StringVisibilityConverter x:Key="StringVisibilityConverter"/>

            <!-- Override the system style -->
            <Style x:Key="AppTitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="FontSize" Value="30"/>
                <!-- Add your custom property overrides -->


            </Style>

            <Style x:Key="HeaderedSectionHeader" TargetType="HyperlinkButton">
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Foreground" Value="{ThemeResource SystemChromeWhiteColor}"/>
            </Style>

            <x:Double x:Key="NarrowMinWidth">0</x:Double>
            <x:Double x:Key="NormalMinWidth">521</x:Double>
            <x:Double x:Key="WideMinWidth">1200</x:Double>

        </ResourceDictionary>
    </Application.Resources>
</Application>
