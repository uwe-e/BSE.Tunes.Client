<Application
    x:Class="BSE.Tunes.WinUI.Client.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:BSE.Tunes.WinUI.Client.Helpers"
    xmlns:models="using:BSE.Tunes.WinUI.Client.Models"
    xmlns:converters="using:BSE.Tunes.WinUI.Client.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="/Styles/FontSizes.xaml" />
                <ResourceDictionary Source="/Styles/Thickness.xaml" />
                <ResourceDictionary Source="/Styles/TextBlock.xaml" />
                <ResourceDictionary Source="/Styles/AppStyles.xaml" />

                <ResourceDictionary Source="/Controls/MenuFlyoutItem/MenuFlyoutItem.xaml" />
                <ResourceDictionary Source="/Controls/Carousel/Carousel.xaml" />
                <ResourceDictionary Source="/Controls/ListView/ExtendedListViewItem.xaml" />

            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CardBackgroundSolidColorDefault" Color="#fdfdfd"/>
                    <!-- This is where the transparency comes from! -->
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CardBackgroundSolidColorDefault" Color="#323232"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Value Converters -->
            <converters:BoolNegationConverter x:Key="BoolNegationConverter"/>
            <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
            <converters:StringVisibilityConverter x:Key="StringVisibilityConverter"/>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:ItemClickEventArgsConverter x:Key="ItemClickEventArgsConverter"/>

            <x:Double x:Key="NarrowMinWidth">0</x:Double>
            <x:Double x:Key="NormalMinWidth">521</x:Double>
            <x:Double x:Key="WideMinWidth">1200</x:Double>

        </ResourceDictionary>
    </Application.Resources>
</Application>
